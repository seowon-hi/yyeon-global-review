rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Custom check for brand role
    function isBrand() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/brands/$(request.auth.uid)) ||
        request.auth.token.email.matches('^.*@brand[.]bemyyyeon[.]com$') ||
        request.auth.token.email == 'jue0252@gmail.com' ||
        request.auth.uid == 'Gj6Z4Lu2RPb4ujh5KYYcfSrwgRx2'
      );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isBrand();
      allow create: if isOwner(userId) && request.resource.data.role == "customer";
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'dob', 'role']);
    }

    match /feedbacks/{feedbackId} {
      allow create: if true; // Allow anonymous feedback as per UI
      allow list, get, update, delete: if isBrand();
    }

    match /product_requests/{requestId} {
      allow create: if true; // Allow anonymous requests as per UI
      allow list, get, update, delete: if isBrand();
    }

    match /brands/{brandId} {
      allow get: if isOwner(brandId);
      allow create: if isOwner(brandId) && request.resource.data.role == "brand";
    }
  }
}
